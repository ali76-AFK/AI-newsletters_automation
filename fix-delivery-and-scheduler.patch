+def test_unexpected_error_in_a_later_schedule_does_not_erase_an_earlier_send(
+    schedules, unique_article, recorder, monkeypatch
+):
+    sub = make_subscriber()
+    first, second = schedules(), schedules()
+
+    from backend.app import schedule_service as svc
+
+    real_due = svc.get_due_instance
+
+    def flaky_due(schedule, now_utc, *args, **kwargs):
+        if schedule.id == second:
+            raise RuntimeError("database exploded")  # not a config error
+        return real_due(schedule, now_utc, *args, **kwargs)
+
+    monkeypatch.setattr(svc, "get_due_instance", flaky_due)
+
+    result = scan(at(0))
+    assert result_for(result, first)["status"] == "sent"
+    assert result_for(result, second)["status"] == "failed"
+
+    # The first schedule's email already went out; its record must have survived
+    # the later rollback, otherwise the next scan in the window would re-send it.
+    assert runs_for(first)[0][0] == "sent"
+    monkeypatch.setattr(svc, "get_due_instance", real_due)  # the fault clears
+    later = scan(at(2))
+    assert result_for(later, first)["status"] == "already_processed"  # not re-sent
+    assert result_for(later, second)["status"] == "sent"  # recovered inside its window
+    assert len(runs_for(first)) == 1
+    # Exactly one email per schedule's own newsletter; the first was never duplicated.
+    assert len(recorder.to(sub)) == 2
