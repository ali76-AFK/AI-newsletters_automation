+# ---------------------------------------------------------------------------
+# Fake SMTP
+# ---------------------------------------------------------------------------
+class FakeSMTP:
+    instances: list["FakeSMTP"] = []
+    refuse: set[str] = set()
+    fail_connect = False
+    reject_login = False
+
+    def __init__(self, host, port, timeout=None, context=None):
+        if FakeSMTP.fail_connect:
+            raise ConnectionRefusedError("[Errno 111] Connection refused")
+        self.host, self.port, self.timeout = host, port, timeout
+        self.kind = "plain"
+        self.starttls_called = False
+        self.login_args = None
+        self.messages = []
+        self.closed = False
+        FakeSMTP.instances.append(self)
+
+    def ehlo(self):
+        pass
+
+    def starttls(self, context=None):
+        self.starttls_called = True
+
+    def login(self, user, password):
+        if FakeSMTP.reject_login:
+            raise smtplib.SMTPAuthenticationError(535, b"bad credentials")
+        self.login_args = (user, password)
+
+    def send_message(self, msg):
+        for addr in FakeSMTP.refuse:
+            if addr in str(msg["To"]):
+                raise smtplib.SMTPRecipientsRefused({addr: (550, b"no such user")})
+        self.messages.append(msg)
+
+    def quit(self):
+        self.closed = True
+
+
+class FakeSMTPSSL(FakeSMTP):
+    def __init__(self, host, port, timeout=None, context=None):
+        super().__init__(host, port, timeout=timeout, context=context)
+        self.kind = "ssl"
+
+
+@pytest.fixture()
+def fake_smtp(monkeypatch):
+    FakeSMTP.instances = []
+    FakeSMTP.refuse = set()
+    FakeSMTP.fail_connect = False
+    FakeSMTP.reject_login = False
+    monkeypatch.setattr(email_sender.smtplib, "SMTP", FakeSMTP)
+    monkeypatch.setattr(email_sender.smtplib, "SMTP_SSL", FakeSMTPSSL)
+    return FakeSMTP
+
