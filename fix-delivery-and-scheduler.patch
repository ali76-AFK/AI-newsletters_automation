+def test_failed_run_is_persisted_and_not_retried_every_minute(schedules, unique_article, recorder):
+    make_subscriber()
+    sid = schedules()
+    recorder.raise_once = EmailSendError("Could not connect to SMTP: boom")
+
+    result = result_for(scan(at(0)), sid)  # the scan itself must not raise
+    assert result["status"] == "failed"
+    assert "boom" in result["message"]
+
+    runs = runs_for(sid)
+    assert len(runs) == 1
+    status, message, newsletter_id = runs[0]
+    assert status == "failed" and "boom" in message
+    assert newsletter_id is None  # the half-built newsletter was rolled back
