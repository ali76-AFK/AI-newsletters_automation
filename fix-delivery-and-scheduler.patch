+def get_due_instance(
+    schedule: NewsletterSchedule,
+    now_utc: datetime,
+    catchup_minutes: int | None = None,
+) -> datetime | None:
+    """
+    Return the scheduled delivery moment (timezone-aware, in the schedule's own
+    timezone) that is currently due, or None.
+
+    A delivery is due from its scheduled minute until ``catchup_minutes`` minutes
+    after that minute ends. ``catchup_minutes=0`` reproduces the old exact-minute
+    behaviour. The look-back covers the previous local day so a 23:58 delivery is
+    still caught by a scan at 00:03.
+
+    Raises ValueError / ScheduleTimezoneError for a malformed schedule.
+    """
+    if not schedule.enabled:
+        return None
+
+    if catchup_minutes is None:
+        catchup_minutes = load_settings().schedule_catchup_minutes
+
+    if now_utc.tzinfo is None:
+        now_utc = now_utc.replace(tzinfo=timezone.utc)
+    else:
+        now_utc = now_utc.astimezone(timezone.utc)
+
+    local_now = schedule_local_time(schedule, now_utc)
+    hour, minute = parse_delivery_time(schedule.delivery_time)
+    weekdays = _parse_weekdays(schedule)
+    window = timedelta(minutes=catchup_minutes + 1)
+
+    for days_back in (0, 1):
+        day = local_now.date() - timedelta(days=days_back)
+        if day.weekday() not in weekdays:
+            continue
+
+        scheduled_local = datetime.combine(
+            day, time(hour, minute), tzinfo=local_now.tzinfo
+        )
+        age = now_utc - scheduled_local.astimezone(timezone.utc)
+        if timedelta(0) <= age < window:
+            return scheduled_local
+
+    return None
+
