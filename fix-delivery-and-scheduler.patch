+
+    result = scan(at(0))
+    assert result_for(result, first)["status"] == "failed"
+    assert result_for(result, second)["status"] == "sent"
+
+    assert runs_for(first)[0][0] == "failed"  # both outcomes are durable
+    assert runs_for(second)[0][0] == "sent"
