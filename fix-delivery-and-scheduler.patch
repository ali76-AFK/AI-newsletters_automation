+    good = schedules()
+
+    result = scan(at(0))
+    assert result_for(result, good)["status"] == "sent"
+    assert result_for(result, broken)["status"] == "failed"
+    assert "Invalid schedule configuration" in runs_for(broken)[0][1]
+    assert recorder.to(sub) == [sub]
+
+    # recorded once per day, not once per minute
+    assert result_for(scan(at(1)), broken) is None
+    assert len(runs_for(broken)) == 1
