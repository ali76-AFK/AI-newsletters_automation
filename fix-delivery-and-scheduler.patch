+# Scheduler: persisted failures, resilient scan, catch-up window
+# ---------------------------------------------------------------------------
+# 2026-08-17 is a Monday. 09:17 Europe/Berlin (CEST, UTC+2) == 07:17 UTC.
+SCHEDULED_UTC = datetime(2026, 8, 17, 7, 17, 5, tzinfo=timezone.utc)
+
+
+def at(minutes_after: int) -> datetime:
+    return SCHEDULED_UTC.replace(minute=17 + minutes_after)
