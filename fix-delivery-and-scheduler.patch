+"""
+Tests for: real SMTP delivery (one message per subscriber), persisted failed runs,
+scan resilience, the schedule catch-up window, and the AI workflow fixes.
+
+Design notes
+- SMTP behaviour is tested against a fake smtplib, so no mail server is needed.
+- Workflow/scheduler tests patch ``delivery.send_individual_emails`` with a recorder
+  and assert only on addresses they create, because the shared dev database may
+  already hold other subscribers/schedules.
+- Scheduler tests inject a unique article instead of relying on stub articles,
+  which earlier runs may already have "consumed".
+"""
+from __future__ import annotations
+
+import json
+import smtplib
+from datetime import datetime, timezone
+from uuid import uuid4
+
+import pytest
+from fastapi.testclient import TestClient
