+# ---------------------------------------------------------------------------
+# Workflow delivery: per-subscriber, idempotent, partial failure
+# ---------------------------------------------------------------------------
+class Recorder:
+    """Stands in for delivery.send_individual_emails."""
+
+    def __init__(self):
+        self.sent: list[OutgoingEmail] = []
+        self.fail: dict[str, str] = {}
+        self.raise_once: Exception | None = None
+        self.calls = 0
+
+    def __call__(self, sender, batch, settings=None):
+        self.calls += 1
+        if self.raise_once is not None:
+            exc, self.raise_once = self.raise_once, None
+            raise exc
+        out = []
+        for item in batch:
+            if item.to in self.fail:
+                out.append(self.fail[item.to])
+            else:
+                self.sent.append(item)
+                out.append(None)
+        return out
+
+    def to(self, *addresses: str) -> list[str]:
+        return [i.to for i in self.sent if i.to in addresses]
+
+
+@pytest.fixture()
+def recorder(monkeypatch):
+    rec = Recorder()
+    monkeypatch.setattr(delivery, "send_individual_emails", rec)
+    return rec
