+def make_subscriber(topic: str = "ai_news") -> str:
+    email = f"{uid('sub')}@example.com"
+    r = client.post("/api/subscribers", json={"email": email, "name": "Sub", "topics": [topic]})
+    assert r.status_code == 201
+    return email
+
+
+def make_approved_newsletter(**extra) -> int:
+    payload = {
+        "title": uid("Newsletter"),
+        "topic": "ai_news",
+        "body": "A calm update on reliable language-model evaluation.",
+    }
+    payload.update(extra)
+    nid = client.post("/api/newsletters", json=payload).json()["id"]
+    assert client.post(f"/api/newsletters/{nid}/classify-and-store").status_code == 200
+    assert client.post(f"/api/newsletters/{nid}/approve").status_code == 200
+    return nid
+
+
+def newsletter_status(nid: int) -> str:
+    with get_session() as db:
+        return db.get(Newsletter, nid).status
+
+
+def test_run_sends_one_message_per_subscriber_and_never_twice(recorder):
+    a, b = make_subscriber(), make_subscriber()
+    nid = make_approved_newsletter()
+
+    first = client.post(f"/api/workflows/newsletter/{nid}/run")
+    assert first.status_code == 200
+    assert sorted(recorder.to(a, b)) == sorted([a, b])  # exactly one each
+    assert newsletter_status(nid) == "sent"
+
+    again = client.post(f"/api/workflows/newsletter/{nid}/run")
+    assert again.status_code == 200
+    assert sorted(recorder.to(a, b)) == sorted([a, b])  # still one each: nothing re-sent
+    summary = again.json()["result"]["send_summary"]
+    assert {a, b} <= set(summary["already_sent"])
+    assert summary["count"] == 0
+
+
+def test_each_subscriber_receives_their_own_personalised_draft(recorder):
+    a = make_subscriber()
+    nid = make_approved_newsletter()
+    client.post(f"/api/workflows/newsletter/{nid}/run")
+
+    with get_session() as db:
+        sub = db.query(Subscriber).filter(Subscriber.email == a).one()
+        draft = db.query(DraftEmail).filter_by(newsletter_id=nid, subscriber_id=sub.id).one()
+        assert draft.status == "sent"
+        sent = next(i for i in recorder.sent if i.to == a)
+        assert (sent.subject, sent.body) == (draft.subject, draft.body)
+
+
+def test_partial_failure_is_reported_and_a_retry_only_resends_the_failed_one(recorder):
+    ok, bad = make_subscriber(), make_subscriber()
+    recorder.fail[bad] = "recipient refused: 550 no such user"
+    nid = make_approved_newsletter()
+
+    r = client.post(f"/api/workflows/newsletter/{nid}/run")
+    assert r.status_code == 200
+    summary = r.json()["result"]["send_summary"]
+    assert summary["failed"][bad].startswith("recipient refused")
+    assert recorder.to(ok, bad) == [ok]
+    assert newsletter_status(nid) == "partially_sent"
