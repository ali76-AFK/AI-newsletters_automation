diff --git a/backend/app/delivery.py b/backend/app/delivery.py
new file mode 100644
index 0000000..432a8f5
--- /dev/null
+++ b/backend/app/delivery.py
@@ -0,0 +1,71 @@
+"""
+Send a newsletter's per-subscriber drafts, one message per subscriber.
+
+Shared by the standard and AI workflow graphs. A draft that is already
+``sent`` is never sent again, so re-running a workflow is safe, and a run that
+failed for only some recipients can be retried without re-emailing the others.
+"""
+from __future__ import annotations
+
+from dataclasses import dataclass, field
+from typing import Dict, List, Sequence
+
+from sqlalchemy.orm import Session
+
+from .email_sender import OutgoingEmail, send_individual_emails
+from .langgraph_state import SubscriberState
+from .models import DraftEmail
+
+
+@dataclass
+class DeliveryOutcome:
+    sent: List[str] = field(default_factory=list)
+    failed: Dict[str, str] = field(default_factory=dict)
+    already_sent: List[str] = field(default_factory=list)
+
+
+def deliver_newsletter_drafts(
+    db: Session,
+    newsletter_id: int,
+    subscribers: Sequence[SubscriberState],
+    sender: str,
+) -> DeliveryOutcome:
+    """
+    Raises EmailSendError only when delivery could not be attempted at all
+    (nothing was sent, draft statuses are untouched).
+    """
+    outcome = DeliveryOutcome()
+    drafts_by_subscriber = {
+        d.subscriber_id: d
+        for d in db.query(DraftEmail)
+        .filter(
+            DraftEmail.newsletter_id == newsletter_id,
+            DraftEmail.subscriber_id.in_([s.id for s in subscribers]),
+        )
+        .all()
+    }
+
+    pending: List[tuple[DraftEmail, str]] = []
+    for sub in subscribers:
+        draft = drafts_by_subscriber.get(sub.id)
+        if draft is None:
+            outcome.failed[sub.email] = "no draft exists for this subscriber"
+            continue
+        if draft.status == "sent":
+            outcome.already_sent.append(sub.email)
+            continue
+        pending.append((draft, sub.email))
+
+    items = [OutgoingEmail(to=email, subject=d.subject, body=d.body) for d, email in pending]
+    errors = send_individual_emails(sender, items)  # may raise EmailSendError
+
+    for (draft, email), error in zip(pending, errors):
+        if error is None:
+            draft.status = "sent"
+            outcome.sent.append(email)
+        else:
+            draft.status = "failed"
+            outcome.failed[email] = error
+
+    db.flush()
+    return outcome
