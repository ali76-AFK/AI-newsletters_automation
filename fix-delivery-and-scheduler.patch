+def test_catchup_crosses_midnight_and_uses_the_scheduled_day():
+    # Monday 23:58 Berlin == 21:58 UTC. Scan at Tuesday 00:03 Berlin == 22:03 UTC.
+    monday_only = make_schedule(weekdays_json="[0]", delivery_time="23:58")
+    now = datetime(2026, 8, 17, 22, 3, tzinfo=timezone.utc)
+
+    assert is_schedule_due(monday_only, now, catchup_minutes=15) is True
+    assert "2026-08-17" in schedule_delivery_window_key(monday_only, now, catchup_minutes=15)
