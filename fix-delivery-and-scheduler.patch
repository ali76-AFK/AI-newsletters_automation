+    base = dict(
+        email_mode="smtp",
+        smtp_host="smtp.provider.test",
+        smtp_username="user",
+        smtp_password="secret",
+        email_from="news@mydomain.org",
+    )
+    base.update(overrides)
+    return Settings(**base)
+
+
+def items(*addresses: str) -> list[OutgoingEmail]:
+    return [OutgoingEmail(to=a, subject="Subj", body="Body") for a in addresses]
